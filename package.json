{
  "name": "actual-budget-mcp",
  "version": "3.2.4",
  "description": "MCP server for Actual Budget using the official @actual-app/api SDK",
  "license": "MIT",
  "author": "Bernard G. Tapiru, Jr.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KazeFreeze/actual-budget-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/KazeFreeze/actual-budget-mcp/issues"
  },
  "homepage": "https://github.com/KazeFreeze/actual-budget-mcp#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "actual-budget",
    "personal-finance",
    "claude",
    "ai"
  ],
  "type": "module",
  "main": "build/src/index.js",
  "bin": {
    "actual-budget-mcp": "build/src/index.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node build/src/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "test:e2e": "vitest run -c vitest.e2e.config.ts",
    "lint": "eslint . && tsc --noEmit",
    "audit:ci": "npm audit --audit-level=high",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write 'src/**/*.ts' 'tests/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts' 'tests/**/*.ts'",
    "prepare": "husky"
  },
  "dependencies": {
    "@actual-app/api": "^26.6.0",
    "@modelcontextprotocol/sdk": "^1.27.0",
    "date-fns": "^4.4.0",
    "dotenv": "^17.3.0",
    "express": "^5.2.0",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "p-retry": "^8.0.0",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.0.1",
    "eslint-plugin-security": "^4.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "msw": "^2.14.6",
    "prettier": "^3.8.3",
    "supertest": "^7.2.2",
    "tsx": "^4.22.4",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.60.1",
    "vitest": "^4.1.8"
  }
}
